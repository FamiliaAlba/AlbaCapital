# Copiar este archivo a .env.local y completar con los valores reales
# del proyecto de Supabase. NUNCA commitear .env ni .env.local.

# URL del proyecto de Supabase (Project Settings > API)
VITE_SUPABASE_URL=

# Publishable key / anon key de Supabase (Project Settings > API)
# IMPORTANTE: nunca usar la service_role key acá, esa clave es secreta
# y solo debe vivir del lado del servidor.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ID del proyecto de Supabase, solo si se usa en el código
VITE_SUPABASE_PROJECT_ID=

# URL pública final del sitio (usada para SEO: canonical, og:url, sitemap)
VITE_SITE_URL=https://albacapital.com
