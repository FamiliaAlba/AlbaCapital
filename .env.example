# Copiar este archivo a .env.local y completar con los valores reales
# del proyecto de Supabase. NUNCA commitear .env ni .env.local.

# URL del proyecto de Supabase (Project Settings > API)
VITE_SUPABASE_URL=

# Publishable key / anon key de Supabase (Project Settings > API)
# IMPORTANTE: nunca usar la service_role key acá, esa clave es secreta
# y solo debe vivir del lado del servidor.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ID del proyecto de Supabase, solo si se usa en el código
VITE_SUPABASE_PROJECT_ID=

# URL pública final del sitio (usada para SEO: canonical, og:url, sitemap)
VITE_SITE_URL=https://albacapital.com

# ---------------------------------------------------------------------------
# Módulo Marketing → Redes sociales (SOLO servidor: variables de Vercel,
# sin prefijo VITE_). Ver README_SOCIAL.md.
# ---------------------------------------------------------------------------
# service_role del proyecto Supabase (secreta, nunca en el navegador)
SUPABASE_SERVICE_ROLE_KEY=
# Clave AES-256 para cifrar tokens, 32 bytes en base64:  openssl rand -base64 32
SOCIAL_TOKEN_ENC_KEY=
# Dominio público canónico (si difiere de VITE_SITE_URL)
SOCIAL_SITE_URL=
# Meta (Facebook Login → Páginas + Instagram profesional)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202609
# true solo si LinkedIn aprobó Community Management API (páginas de empresa)
LINKEDIN_ENABLE_ORG_PAGES=false
